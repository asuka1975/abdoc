# backend が読む環境変数（設定は環境変数のみ。コードが参照する変数と一致させること）
# 待ち受けポート。未設定なら 8080。Cloud Run では自動で設定される。
PORT=8080

# Firestore / BigQuery のプロジェクト ID。未設定ならインメモリのストアで動く（ローカル開発用、再起動で消える）。
GOOGLE_CLOUD_PROJECT=abdoc-local
# イベント（engagement_events / reaction_events）を書き込む BigQuery のデータセット。GOOGLE_CLOUD_PROJECT があるときは必須。
# データセットとテーブルは backend では作らない（本番は Terraform、ローカルはエミュレータの初期データ）。
BIGQUERY_DATASET=abdoc

# エミュレータの host:port。本番では設定しない。値は compose.yaml の backend と同じ（ホストから動かすなら localhost:...）。
FIRESTORE_EMULATOR_HOST=localhost:8081
BIGQUERY_EMULATOR_HOST=localhost:9050
