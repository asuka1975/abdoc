---
/**
 * 全ページ共通の外枠。`<head>`、本文（デフォルトスロット）、フッター、Cookie の同意バナーを出す。
 * `<head>` に足すものはスロット `head` に渡す。
 */
import ConsentBanner from "../components/ConsentBanner.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <footer>
      <a href="/privacy/">プライバシーポリシー</a>
      <button type="button" data-consent-open hidden>Cookie の設定</button>
    </footer>
    <ConsentBanner />
  </body>
</html>

<style>
  footer {
    display: flex;
    gap: 1rem;
    align-items: center;
    max-width: 40rem;
    margin: 0 auto;
    padding: 1rem 1rem 8rem;
    border-top: 1px solid #ccc;
    font-family: system-ui, sans-serif;
    font-size: 0.875rem;
  }
  footer [hidden] {
    display: none;
  }
</style>
